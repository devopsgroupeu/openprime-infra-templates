serviceAccount:
  create: true
  name: ${service_account_name}
  annotations:
    eks.amazonaws.com/role-arn: ${external_dns_role_arn}

# Only manage the customer's own zone. This used to say openprime.io, i.e. it told
# external-dns to look for OUR zone inside THEIR account (OP-244). With no domain
# configured a filter on the reserved .invalid TLD is emitted instead of an empty
# list: an empty domainFilters removes --domain-filter altogether, which lets
# external-dns act on every zone in the account.
domainFilters: ${domain_filters}

provider: aws

env:
  - name: AWS_DEFAULT_REGION
    value: ${region}

policy: sync
registry: txt
txtOwnerId: "${cluster_name}"